# Variables de entorno del backend. Copia este archivo como .env (está en .gitignore) y completa los valores.
# El backend lee ./.env o ../.env al arrancar (formato .properties: CLAVE=valor, sin comillas ni "export").
# Las variables del sistema (PowerShell $env:..., Docker, el panel del hosting) tienen prioridad sobre este archivo.
# Detalle de cada una (formato, cómo generarla, valor local y de producción): docs/configuracion.md

# --- Obligatorias: sin ellas el backend no arranca ---
DB_URL=jdbc:postgresql://localhost:5432/omni
DB_USERNAME=omni
DB_PASSWORD=omni

# --- Muy recomendada: cifra tokens de WhatsApp Cloud API, llaves de Culqi de cada tienda, facturación y la verificación en dos pasos ---
# 32 bytes aleatorios en Base64 (44 caracteres). Genera la tuya; no reutilices el ejemplo y no la cambies después.
#   Linux/macOS: openssl rand -base64 32
#   PowerShell : $b=[byte[]]::new(32); [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
SECRETS_ENCRYPTION_KEY=

# --- URLs públicas ---
# Frontend (enlaces de correos, catálogo para la IA).
APP_BASE_URL=http://localhost:3000
STOREFRONT_BASE_URL=http://localhost:3000
# Backend visto desde internet (URLs de webhook de Meta, Evolution y Culqi). En local, la URL de ngrok o similar.
PUBLIC_API_BASE_URL=
EVOLUTION_CALLBACK_BASE_URL=

# --- Superadmin (consola /superadmin). Vacío = consola deshabilitada ---
SUPERADMIN_EMAIL=
# Hash BCrypt de la contraseña ($2a$10$...). Ver docs/configuracion.md para generarlo.
SUPERADMIN_PASSWORD_HASH=
# Opcional (heredado): secreto TOTP Base32 de 32 caracteres. Lo normal es enrolar la app con QR en el primer ingreso.
SUPERADMIN_TOTP_SECRET=

# --- IA vendedora (Gemini) ---
# Descoméntala solo con una clave real: vacía hace fallar el arranque (Spring AI exige un valor).
# GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
AI_DEBOUNCE_MS=8000

# --- Multimedia entrante (cada servicio es independiente; apagado no bloquea nada) ---
# Sightengine: filtro NSFW de las fotos que envían los clientes.
SIGHTENGINE_ENABLED=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_NSFW_THRESHOLD=0.7
SIGHTENGINE_TIMEOUT_MS=8000
# Groq Whisper: transcribe las notas de voz una sola vez.
GROQ_TRANSCRIPTION_ENABLED=false
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_LANGUAGE=es
GROQ_TIMEOUT_MS=20000
# Visión del catálogo (Gemini Flash-Lite): describe la prenda de la foto y busca parecidas. La IA principal no ve la imagen.
VISION_ENABLED=false
# Vacía usa GOOGLE_GENAI_API_KEY.
VISION_GEMINI_API_KEY=
VISION_MODEL=gemini-flash-lite-latest
VISION_TIMEOUT_MS=15000
# true: sin un "seguro" de Sightengine la foto no se analiza (recomendado).
VISION_REQUIRE_MODERATION=true

# --- Archivos (Cloudinary). Vacías: fotos, logos, catálogos y multimedia de WhatsApp se guardan en la base ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz; cada tienda usa {carpeta}/{storeId}/...
CLOUDINARY_FOLDER=omnicanal
# true: al arrancar sube a Cloudinary los archivos antiguos guardados en la base (deja de ocupar espacio en Neon).
CLOUDINARY_BACKFILL=false

# --- Correo (Resend). Sin clave, los correos solo se registran en email_log y en el log ---
RESEND_API_KEY=
EMAIL_FROM=Omnicanal <onboarding@resend.dev>
EMAIL_REPLY_TO=

# --- Cobro de la suscripción del SaaS (Culqi) ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_TOKEN=

# --- Cobros de las tiendas ---
# No hay variables: cada dueño conecta sus propias llaves de Culqi (pk_/sk_) desde "Activar cobros en línea".
# La llave secreta se guarda cifrada con SECRETS_ENCRYPTION_KEY y el webhook de cada tienda es
# {PUBLIC_API_BASE_URL}/api/webhooks/culqi/stores/{storeId}.

# --- WhatsApp ---
WHATSAPP_GRAPH_VERSION=v23.0
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# --- Login con Google en la tienda pública (OAuth Client ID web). Vacío = sin botón de Google ---
GOOGLE_CLIENT_ID=

# --- Facturación electrónica (Nubefact) ---
# No hay variables: cada dueño pega la RUTA y el TOKEN de su cuenta de Nubefact en Facturación.
# El TOKEN se guarda cifrado con SECRETS_ENCRYPTION_KEY.

# --- Solo para adoptar una base existente sin historial de Flyway ---
FLYWAY_BASELINE_ON_MIGRATE=false

# --- Frontend (Next.js): van en frontend/.env.local, no aquí ---
# BACKEND_API_URL=http://localhost:8080/api
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# STOREFRONT_PUBLIC_URL=http://localhost:3000
