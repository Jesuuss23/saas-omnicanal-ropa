# Variables de entorno del backend. Copia este archivo como .env (está en .gitignore) y completa los valores.
# El backend lee ./.env o ../.env al arrancar (formato .properties: CLAVE=valor, sin comillas ni "export").
# Las variables del sistema (PowerShell $env:..., Docker, el panel del hosting) tienen prioridad sobre este archivo.
# Detalle de cada una (formato, cómo generarla, valor local y de producción): docs/configuracion.md

# --- Obligatorias: sin ellas el backend no arranca ---
DB_URL=jdbc:postgresql://localhost:5432/omni
DB_USERNAME=omni
DB_PASSWORD=omni

# --- Muy recomendada: cifra tokens de WhatsApp Cloud API, Mercado Pago, facturación y la verificación en dos pasos ---
# 32 bytes aleatorios en Base64 (44 caracteres). Genera la tuya; no reutilices el ejemplo y no la cambies después.
#   Linux/macOS: openssl rand -base64 32
#   PowerShell : $b=[byte[]]::new(32); [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
SECRETS_ENCRYPTION_KEY=

# --- URLs públicas ---
# Frontend (enlaces de correos, retorno de Mercado Pago, catálogo para la IA).
APP_BASE_URL=http://localhost:3000
STOREFRONT_BASE_URL=http://localhost:3000
# Backend visto desde internet (URLs de webhook de Meta, Evolution, Mercado Pago y Culqi). En local, la URL de ngrok o similar.
PUBLIC_API_BASE_URL=
EVOLUTION_CALLBACK_BASE_URL=

# --- Superadmin (consola /superadmin). Vacío = consola deshabilitada ---
SUPERADMIN_EMAIL=
# Hash BCrypt de la contraseña ($2a$10$...). Ver docs/configuracion.md para generarlo.
SUPERADMIN_PASSWORD_HASH=
# Opcional (heredado): secreto TOTP Base32 de 32 caracteres. Lo normal es enrolar la app con QR en el primer ingreso.
SUPERADMIN_TOTP_SECRET=

# --- IA vendedora (Gemini) ---
# Descoméntala solo con una clave real: vacía hace fallar el arranque (Spring AI exige un valor).
# GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
AI_DEBOUNCE_MS=8000

# --- Correo (Resend). Sin clave, los correos solo se registran en email_log y en el log ---
RESEND_API_KEY=
EMAIL_FROM=Omnicanal <onboarding@resend.dev>
EMAIL_REPLY_TO=

# --- Cobro de la suscripción del SaaS (Culqi) ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_TOKEN=

# --- Cobros de las tiendas (Mercado Pago, aplicación marketplace del SaaS) ---
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=

# --- WhatsApp ---
WHATSAPP_GRAPH_VERSION=v23.0
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# --- Login con Google en la tienda pública (OAuth Client ID web). Vacío = sin botón de Google ---
GOOGLE_CLIENT_ID=

# --- Facturación electrónica (APISPERU) ---
APISPERU_ACCOUNT_TOKEN=
APISPERU_EMISSION_KEY=
# APISPERU_BETA_COMPANY_TOKEN_<companyId>=

# --- Solo para adoptar una base existente sin historial de Flyway ---
FLYWAY_BASELINE_ON_MIGRATE=false

# --- Frontend (Next.js): van en frontend/.env.local, no aquí ---
# BACKEND_API_URL=http://localhost:8080/api
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# STOREFRONT_PUBLIC_URL=http://localhost:3000
