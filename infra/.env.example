# Copia este archivo a infra/.env (no se versiona) y completa los valores.
EVOLUTION_API_KEY=cambia-esta-clave-global-de-evolution
EVOLUTION_DATABASE_URI=postgresql://usuario:clave@host:5432/evolution?sslmode=require

# Correos transaccionales (Resend). Sin clave, los correos quedan en email_log y en el log.
RESEND_API_KEY=
EMAIL_FROM=Omnicanal <no-reply@tu-dominio.pe>
EMAIL_REPLY_TO=
# URL pública del frontend para los enlaces de los correos.
APP_BASE_URL=http://localhost:3000

# Ingreso de compradores con Google en la tienda pública (OAuth client ID web). Vacío = sin botón de Google.
GOOGLE_CLIENT_ID=

# IA vendedora (Gemini, Google AI Studio). Vacío = la IA no responde.
GOOGLE_GENAI_API_KEY=
